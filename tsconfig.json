{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"], "types": ["vite/client", "node"],
    "strict": true, "noFallthroughCasesInSwitch": true, "isolatedModules": true, "skipLibCheck": true, "resolveJsonModule": true, "noEmit": true, "allowJs": false
  },
  "include": ["src", "tests", "vite.config.ts", "vitest.setup.ts"]
}
