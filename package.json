{
  "name": "asistente-documental",
  "version": "2.0.0-fase1",
  "private": true,
  "description": "Asistente Documental · ESSA — aplicación 100 % en el navegador (recursos, cuadro de mando y generación documental).",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:ci": "npm run typecheck && npm run lint && npm run test && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "parity": "python tools/parity/parity_check.py --url http://localhost:4173/",
    "parity:storage": "python tools/parity/storage_compat.py"
  },
  "dependencies": {
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  }
}
